# Never paste real credentials into this tracked file.
# Legacy review settings below. The opt-in coding pilot is documented in
# docs/MVP_CODING_QUICKSTART.md and uses a session SOAR_PATCH_API_KEY.
# Keep session keys out of this file.

# Use the base URL ending in /v1, not the /v1/models resource URL.
SOAR_VLLM_BASE_URL=http://localhost:8000/v1
SOAR_VLLM_API_KEY=
SOAR_VLLM_MODEL=your-served-model-name
# Explicit accounting policy for a self-hosted endpoint; this is a declaration,
# not a measurement of electricity or infrastructure cost.
SOAR_VLLM_COST_POLICY=local_zero_cost
SOAR_ALLOW_INSECURE_VLLM_HTTP=false

# The shipping vertical slice always uses local. "fake" is reserved for deterministic tests.
SOAR_PROVIDER_MODE=local
# Test-only delay used by the deterministic fake provider.
SOAR_FAKE_DELAY_MS=12
SOAR_MAX_INFERENCE_ROUNDS=24
SOAR_MAX_TOOL_CALLS=24
# These two apply to the legacy review adapter only; General task takes its limits from the profile below.
SOAR_MAX_OUTPUT_TOKENS=8192
SOAR_REQUEST_TIMEOUT_MS=300000
# Provider-neutral context packet budget. The compiler reserves the safety margin.
SOAR_CONTEXT_MAX_INPUT_TOKENS=18432
SOAR_CONTEXT_SAFETY_MARGIN=0.2

# General task requires an existing, qualified Docker image. Supply its immutable
# sha256 image ID in the machine-local environment. No image is pulled automatically.
# SOAR_GENERAL_TASK_IMAGE_ID=sha256:<64 lowercase hexadecimal characters>
# Coordinator profile for General task: "heavy" (default: thinking on, 16K output tokens, 80 calls / 90 min)
# or "standard" (the September profile: thinking off, 4,096 tokens, 20 calls / 15 min).
# SOAR_GENERAL_TASK_PROFILE=heavy

# Optional general-task consultant. Disabled unless every required value is set
# explicitly in the host process environment. These are NOT loaded from .env.
# No legacy cloud key/profile is reused. Approving a preview and then choosing
# Resume is still required before one consultant request. Never track real keys.
# ENDPOINT is the exact HTTPS chat-completions URL, not a models/base URL.
# SOAR_GENERAL_CONSULTANT_ENDPOINT=https://provider.example/v1/chat/completions
# SOAR_GENERAL_CONSULTANT_MODEL=explicit-model-id
# SOAR_GENERAL_CONSULTANT_SERVICE_TIER=default
# SOAR_GENERAL_CONSULTANT_ACCOUNT_ID=explicit-account-id
# SOAR_GENERAL_CONSULTANT_CREDENTIAL_VERSION=1
# SOAR_GENERAL_CONSULTANT_API_KEY=<session-only credential>
# SOAR_GENERAL_CONSULTANT_MAX_OUTPUT_TOKENS=4096
# Prices are integer micro-USD per one million tokens; supply actual approved rates.
# SOAR_GENERAL_CONSULTANT_INPUT_MICROUSD_PER_MILLION=<integer>
# SOAR_GENERAL_CONSULTANT_OUTPUT_MICROUSD_PER_MILLION=<integer>
# SOAR_GENERAL_CONSULTANT_CACHED_INPUT_MICROUSD_PER_MILLION=<optional integer>
# SOAR_GENERAL_CONSULTANT_TIMEOUT_MS=300000
# SOAR_GENERAL_CONSULTANT_MAX_FEE_MICROUSD=<explicit per-consultation cap>
# Controlled receivers only: NODE_ENV=test plus the following explicit flag
# permits literal 127.0.0.1/[::1] HTTP. It cannot enable a remote HTTP profile.
# SOAR_GENERAL_CONSULTANT_LOOPBACK_FIXTURE=true
