# Never paste real credentials into this tracked file.
# This example lists only inputs parsed by the current local-only runtime.
# Cloud credentials and paid-budget settings are intentionally absent because
# this build does not parse or enable them.

# Use the base URL ending in /v1, not the /v1/models resource URL.
SOAR_VLLM_BASE_URL=http://localhost:8000/v1
SOAR_VLLM_API_KEY=
SOAR_VLLM_MODEL=your-served-model-name
# Explicit accounting policy for a self-hosted endpoint; this is a declaration,
# not a measurement of electricity or infrastructure cost.
SOAR_VLLM_COST_POLICY=local_zero_cost
SOAR_ALLOW_INSECURE_VLLM_HTTP=false

# The shipping vertical slice always uses local. "fake" is reserved for deterministic tests.
SOAR_PROVIDER_MODE=local
# Test-only delay used by the deterministic fake provider.
SOAR_FAKE_DELAY_MS=12
SOAR_MAX_INFERENCE_ROUNDS=24
SOAR_MAX_TOOL_CALLS=24
SOAR_MAX_OUTPUT_TOKENS=8192
SOAR_REQUEST_TIMEOUT_MS=300000
# Provider-neutral context packet budget. The compiler reserves the safety margin.
SOAR_CONTEXT_MAX_INPUT_TOKENS=18432
SOAR_CONTEXT_SAFETY_MARGIN=0.2
