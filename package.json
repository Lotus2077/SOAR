{
  "name": "soar",
  "version": "0.0.0",
  "description": "A macOS-first local and cloud agentic task router.",
  "author": "Lotus2077",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lotus2077/SOAR.git"
  },
  "bugs": {
    "url": "https://github.com/Lotus2077/SOAR/issues"
  },
  "homepage": "https://github.com/Lotus2077/SOAR#readme",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.12.4 <11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live-vllm": "SOAR_RUN_LIVE_VLLM=true vitest run tests/integration/live-vllm.test.ts --testTimeout=600000",
    "test:live-review-schema": "SOAR_RUN_LIVE_REVIEW_SCHEMA=true vitest run tests/integration/live-review-schema.test.ts --testTimeout=600000 --disableConsoleIntercept",
    "test:live-repository": "SOAR_RUN_LIVE_REPOSITORY=true vitest run tests/integration/local-repository-investigator.test.ts --testTimeout=1200000",
    "test:e2e": "node scripts/run-electron-e2e.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts",
    "benchmark:preflight": "node --experimental-strip-types scripts/benchmark.ts preflight",
    "calibration:generate": "tsx benchmarks/change-review/generate-calibration.ts",
    "postinstall": "electron-builder install-app-deps",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package:mac": "pnpm build && node scripts/package-mac.mjs",
    "check": "pnpm validate:readiness && pnpm validate:build-log && pnpm typecheck && pnpm test && pnpm build",
    "check:cloud-key": "node scripts/check-openrouter-key.mjs",
    "validate:readiness": "node scripts/validate-readiness.mjs",
    "validate:build-log": "node --experimental-strip-types scripts/validate-build-log.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-sqlite3": "^13.0.3",
    "diff": "9.0.0",
    "dotenv": "^17.4.2",
    "openai": "^7.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "tsx": "4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
