.DS_Store
# A directory or a symlink: worktrees share one install through a link.
node_modules
.pnpm-store/
dist/
out/
native/**/build/
coverage/
playwright-report/
test-results/
__pycache__/
*.pyc

# Secrets and machine-local configuration
.env
.env.*
!.env.example
*.pem
*.key
# Claude Code's machine-local settings and agent worktrees; an untracked file here would mark every run's tree dirty.
.claude/settings.local.json
.claude/worktrees/

# Runtime state and downloaded benchmark fixtures
.soar/
benchmarks/cache/
benchmarks/runs/
